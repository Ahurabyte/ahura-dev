---
/* Shared admin layout: auth gate, nav, API client, toasts, dialogs, helpers.
 *
 * IMPORTANT: the <style> below is `is:global` on purpose. Astro scopes plain
 * <style> blocks (".adm-card" becomes ".adm-card[data-astro-cid-xxxx]"), so the
 * old rules only matched markup written inside THIS file. Everything the pages
 * render (cards, tables, badges, rows, the chart, toasts...) — whether in the
 * page template or built with innerHTML — never matched and stayed unstyled. */
import { withBase } from "../../lib/posts";

interface Props {
  title: string;
  page:
    | "dashboard"
    | "writing"
    | "posts"
    | "drafts"
    | "media"
    | "analytics"
    | "subscribers"
    | "campaigns"
    | "settings";
  fluid?: boolean;
}

const { title, page, fluid = false } = Astro.props;

const nav = [
  { id: "dashboard", label: "داشبورد", href: withBase("/admin/") },
  { id: "writing", label: "استودیو نوشتن", href: withBase("/admin/writing/") },
  { id: "posts", label: "نوشته‌ها", href: withBase("/admin/posts/") },
  { id: "drafts", label: "پیش‌نویس‌ها", href: withBase("/admin/drafts/") },
  { id: "media", label: "رسانه‌ها", href: withBase("/admin/media/") },
  { id: "analytics", label: "آمار بازدید", href: withBase("/admin/analytics/") },
  { id: "subscribers", label: "مشترکین", href: withBase("/admin/subscribers/") },
  { id: "campaigns", label: "کمپین‌ها", href: withBase("/admin/campaigns/") },
  { id: "settings", label: "تنظیمات", href: withBase("/admin/settings/") },
];
const siteHome = withBase("/");
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1c1a15" />
    <title>{title} — مدیریت وبلاگ اهورا</title>
    <script is:inline>
      // Apply the saved theme before first paint (same key as the public site).
      try {
        if (localStorage.getItem("ahura-theme") !== "light") document.documentElement.classList.add("dark");
      } catch (e) {}
    </script>
    <style is:global>
      :root {
        --adm-bg: #f7efe4;
        --adm-panel: #fffdf8;
        --adm-border: #e0d9c8;
        --adm-text: #2e2b22;
        --adm-muted: #6b6558;
        --adm-accent: #5f5b52;
        --adm-on-accent: #f7efe4;
        --adm-err: #a33b2e;
        --adm-ok: #3d7a44;
        --adm-focus: #b98a2f;
        --adm-hover: rgba(0, 0, 0, 0.05);
        --adm-radius: 12px;
        color-scheme: light;
      }
      html.dark {
        --adm-bg: #1c1a15;
        --adm-panel: #26231c;
        --adm-border: #3a352a;
        --adm-text: #ece5d3;
        --adm-muted: #a89e86;
        --adm-accent: #c9bfa8;
        --adm-on-accent: #1c1a15;
        --adm-err: #e08073;
        --adm-ok: #7bc47f;
        --adm-focus: #d9a94a;
        --adm-hover: rgba(255, 255, 255, 0.07);
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--adm-bg);
        color: var(--adm-text);
        font-family: Vazirmatn, Vazir, Tahoma, system-ui, sans-serif;
        line-height: 1.65;
        min-height: 100vh;
        min-height: 100dvh;
      }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--adm-focus); outline-offset: 2px; }
      [hidden] { display: none !important; }

      /* ---------- login ---------- */
      .adm-login { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--adm-bg); z-index: 50; padding: 20px; overflow-y: auto; }
      .adm-login-card { background: var(--adm-panel); border: 1px solid var(--adm-border); border-radius: var(--adm-radius); padding: 32px; width: 100%; max-width: 400px; }
      .adm-login-card h1 { margin: 0 0 8px; font-size: 1.4rem; }
      .adm-login-card p { color: var(--adm-muted); font-size: 0.9rem; margin: 0 0 20px; }
      .adm-login-err { color: var(--adm-err); font-size: 0.88rem; margin: 12px 0 0 !important; }

      /* ---------- app frame ---------- */
      .adm-app { display: flex; flex-direction: column; min-height: 100vh; min-height: 100dvh; }
      /* full-height pages (writing studio): the frame itself is the viewport, so
       * the studio can simply fill the remaining space instead of guessing the
       * height of the bars above it with calc(100vh - Npx). */
      .adm-app.adm-app-fluid { height: 100vh; height: 100dvh; min-height: 0; overflow: hidden; }
      .adm-topbar { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 20px; border-bottom: 1px solid var(--adm-border); background: var(--adm-panel); position: sticky; top: 0; z-index: 20; }
      .adm-brand { font-family: "Playfair Display", serif; font-weight: 700; font-size: 1.05rem; white-space: nowrap; }
      .adm-top-actions { display: flex; align-items: center; gap: 8px; }
      .adm-nav { flex: 0 0 auto; display: flex; gap: 4px; padding: 8px 20px; border-bottom: 1px solid var(--adm-border); background: var(--adm-panel); overflow-x: auto; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
      .adm-nav a { display: inline-flex; align-items: center; min-height: 38px; padding: 4px 14px; border-radius: 8px; text-decoration: none; color: var(--adm-muted); font-size: 0.92rem; white-space: nowrap; }
      .adm-nav a:hover { background: var(--adm-hover); }
      .adm-nav a.active { background: var(--adm-accent); color: var(--adm-on-accent); }
      .adm-main { flex: 1 0 auto; width: 100%; max-width: 1200px; margin: 0 auto; padding: 24px 20px 40px; }
      .adm-main.fluid { flex: 1 1 0; min-height: 0; max-width: none; padding: 0; margin: 0; display: flex; overflow: hidden; }
      .adm-page-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
      .adm-page-head h1 { font-size: 1.25rem; margin: 0; }

      /* ---------- form controls (16px: iOS zooms the page on smaller inputs) ---------- */
      .adm-field { margin-bottom: 14px; }
      .adm-field label { display: block; font-size: 0.85rem; margin-bottom: 6px; color: var(--adm-muted); }
      .adm-input, .adm-select, .adm-textarea {
        width: 100%; min-height: 42px; padding: 8px 12px; border: 1px solid var(--adm-border);
        border-radius: 10px; background: var(--adm-bg); color: var(--adm-text);
        font-family: inherit; font-size: 1rem;
      }
      .adm-textarea { min-height: 140px; resize: vertical; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.92rem; direction: ltr; text-align: left; }
      .adm-input::placeholder { color: var(--adm-muted); opacity: 0.8; }

      .adm-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        min-height: 42px; padding: 8px 18px; border: 1px solid transparent; border-radius: 10px;
        background: var(--adm-accent); color: var(--adm-on-accent); font-family: inherit;
        font-size: 0.95rem; line-height: 1.3; cursor: pointer; text-decoration: none; white-space: nowrap;
      }
      .adm-btn:hover:not(:disabled) { filter: brightness(1.07); }
      .adm-btn:disabled { opacity: 0.5; cursor: default; }
      .adm-btn-ghost { background: transparent; color: var(--adm-text); border-color: var(--adm-border); }
      .adm-btn-ghost:hover:not(:disabled) { background: var(--adm-hover); filter: none; }
      .adm-btn-danger { background: var(--adm-err); color: #fff; }
      .adm-btn-sm { min-height: 34px; padding: 4px 12px; font-size: 0.85rem; border-radius: 8px; }
      .adm-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border: 1px solid var(--adm-border); border-radius: 10px; background: transparent; color: var(--adm-text); font-size: 1.1rem; cursor: pointer; padding: 0; }
      .adm-icon-btn:hover { background: var(--adm-hover); }

      /* ---------- layout bits ---------- */
      .adm-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
      .adm-row .adm-input { flex: 1 1 200px; width: auto; min-width: 0; }
      .adm-row .adm-select { flex: 0 1 auto; width: auto; }
      .adm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin-bottom: 24px; }
      .adm-grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
      .adm-card { background: var(--adm-panel); border: 1px solid var(--adm-border); border-radius: var(--adm-radius); padding: 16px; min-width: 0; }
      .adm-card h3 { margin: 0 0 4px; font-size: 0.85rem; color: var(--adm-muted); font-weight: 500; }
      .adm-card .num { font-size: 1.7rem; font-weight: 800; line-height: 1.3; font-variant-numeric: tabular-nums; }
      .adm-card .sub { font-size: 0.78rem; color: var(--adm-muted); }
      .adm-delta { font-size: 0.78rem; font-weight: 600; }
      .adm-delta.up { color: var(--adm-ok); }
      .adm-delta.down { color: var(--adm-err); }
      .adm-section { margin-bottom: 28px; }
      .adm-section h2 { font-size: 1.1rem; margin: 0 0 12px; }
      .adm-empty, .adm-loading, .adm-error { padding: 28px 16px; text-align: center; color: var(--adm-muted); }
      .adm-error { color: var(--adm-err); }
      .adm-notice { background: var(--adm-panel); border: 1px solid var(--adm-border); border-inline-start: 4px solid var(--adm-focus); border-radius: var(--adm-radius); padding: 12px 16px; margin-bottom: 16px; font-size: 0.92rem; }
      .adm-notice.err { border-inline-start-color: var(--adm-err); }
      .adm-notice.ok { border-inline-start-color: var(--adm-ok); }
      .adm-muted { color: var(--adm-muted); }
      code, .adm-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.88em; background: var(--adm-hover); padding: 1px 6px; border-radius: 6px; direction: ltr; unicode-bidi: embed; }

      /* ---------- tables (cards on phones) ---------- */
      .adm-table-wrap { overflow-x: auto; padding: 4px 8px; }
      table.adm-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      table.adm-table th, table.adm-table td { text-align: right; padding: 10px 12px; border-bottom: 1px solid var(--adm-border); vertical-align: middle; }
      table.adm-table tbody tr:last-child td { border-bottom: 0; }
      table.adm-table th { color: var(--adm-muted); font-weight: 500; font-size: 0.82rem; white-space: nowrap; }
      table.adm-table td.ltr { direction: ltr; text-align: left; word-break: break-all; }
      table.adm-table td.adm-td-actions .adm-row { margin: 0; gap: 6px; }
      table.adm-table td.adm-td-actions { white-space: nowrap; }
      table.adm-table a { text-decoration: none; border-bottom: 1px dotted var(--adm-muted); }
      @media (max-width: 700px) {
        .adm-tw.adm-card { background: none; border: 0; padding: 0; overflow: visible; }
        table.adm-table.stack, table.adm-table.stack tbody, table.adm-table.stack tr, table.adm-table.stack td { display: block; width: 100%; }
        table.adm-table.stack thead { display: none; }
        table.adm-table.stack tr { background: var(--adm-panel); border: 1px solid var(--adm-border); border-radius: var(--adm-radius); margin-bottom: 10px; padding: 6px 14px; }
        table.adm-table.stack td { display: flex; justify-content: space-between; align-items: center; gap: 14px; border: 0; padding: 7px 0; text-align: start; min-width: 0; }
        table.adm-table.stack td::before { content: attr(data-label); color: var(--adm-muted); font-size: 0.78rem; flex: 0 0 auto; }
        table.adm-table.stack td.ltr { direction: rtl; text-align: start; }
        table.adm-table.stack td.adm-td-actions { padding-top: 10px; border-top: 1px dashed var(--adm-border); margin-top: 4px; white-space: normal; }
        table.adm-table.stack td.adm-td-actions::before { display: none; }
        table.adm-table.stack td.adm-td-actions .adm-row { width: 100%; }
        table.adm-table.stack td.adm-td-actions .adm-btn { flex: 1 1 auto; }
      }

      /* ---------- badges ---------- */
      .adm-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 0.78rem; white-space: nowrap; }
      .adm-badge.confirmed, .adm-badge.sent, .adm-badge.published { background: #dcefe0; color: #2d6a32; }
      .adm-badge.pending_confirmation, .adm-badge.draft, .adm-badge.sending { background: #f3e8c8; color: #7a5c14; }
      .adm-badge.unsubscribed, .adm-badge.failed, .adm-badge.bounced { background: #f3d9d4; color: #93362a; }
      html.dark .adm-badge.confirmed, html.dark .adm-badge.sent, html.dark .adm-badge.published { background: #2c4a2e; color: #a8d5ab; }
      html.dark .adm-badge.pending_confirmation, html.dark .adm-badge.draft, html.dark .adm-badge.sending { background: #4a3f22; color: #e3c878; }
      html.dark .adm-badge.unsubscribed, html.dark .adm-badge.failed, html.dark .adm-badge.bounced { background: #4a2a24; color: #e0988b; }

      /* ---------- pagination ---------- */
      .adm-pagination { display: flex; gap: 8px; align-items: center; justify-content: center; flex-wrap: wrap; margin-top: 14px; font-size: 0.9rem; color: var(--adm-muted); }

      /* ---------- toasts ---------- */
      #adm-toast { position: fixed; bottom: 20px; inset-inline-start: 20px; z-index: 600; display: flex; flex-direction: column; gap: 8px; max-width: min(420px, calc(100vw - 32px)); pointer-events: none; }
      .adm-toast-msg { background: var(--adm-text); color: var(--adm-bg); padding: 12px 16px; border-radius: 10px; font-size: 0.9rem; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25); pointer-events: auto; overflow-wrap: anywhere; }
      .adm-toast-msg.err { background: var(--adm-err); color: #fff; }

      /* ---------- dialogs ---------- */
      .adm-overlay { position: fixed; inset: 0; z-index: 500; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; padding: 16px; }
      .adm-dialog { background: var(--adm-panel); color: var(--adm-text); border: 1px solid var(--adm-border); border-radius: 14px; padding: 20px; width: 100%; max-width: 440px; max-height: calc(100vh - 32px); max-height: calc(100dvh - 32px); overflow: auto; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35); }
      .adm-dialog.wide { max-width: min(920px, 100%); }
      .adm-dialog h3 { margin: 0 0 10px; font-size: 1.05rem; }
      .adm-dialog-msg { margin: 0 0 16px; white-space: pre-line; overflow-wrap: anywhere; }
      .adm-dialog-actions { display: flex; gap: 10px; flex-wrap: wrap; }
      .adm-dialog-actions .adm-btn { flex: 1 1 120px; }
      .adm-preview-frame { width: 100%; height: min(70vh, 640px); border: 1px solid var(--adm-border); border-radius: 10px; background: #fff; }

      /* ---------- bar chart (plain HTML/CSS: scales to any width, readable on touch) ---------- */
      .adm-bars { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 8px; direction: ltr; }
      .adm-bars-y { display: flex; flex-direction: column; justify-content: space-between; height: 170px; font-size: 0.7rem; color: var(--adm-muted); text-align: right; font-variant-numeric: tabular-nums; }
      .adm-bars-plot { display: flex; align-items: flex-end; gap: 2px; height: 170px; border-bottom: 1px solid var(--adm-border); background-image: linear-gradient(var(--adm-border) 1px, transparent 1px); background-size: 100% 50%; }
      .adm-bar { flex: 1 1 0; min-width: 0; height: 100%; display: flex; align-items: flex-end; padding: 0; border: 0; background: none; cursor: pointer; }
      .adm-bar span { display: block; width: 100%; min-height: 2px; background: var(--adm-accent); border-radius: 3px 3px 0 0; opacity: 0.75; }
      .adm-bar:hover span, .adm-bar.on span { opacity: 1; background: var(--adm-focus); }
      .adm-bars-axis { grid-column: 2; display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--adm-muted); }
      .adm-bars-tip { grid-column: 1 / -1; font-size: 0.85rem; color: var(--adm-muted); min-height: 1.6em; text-align: center; direction: rtl; }
      .adm-meter { height: 8px; border-radius: 99px; background: var(--adm-hover); overflow: hidden; min-width: 60px; }
      .adm-meter i { display: block; height: 100%; background: var(--adm-accent); border-radius: 99px; }

      /* ---------- responsive ---------- */
      @media (max-width: 820px) {
        .adm-topbar, .adm-nav { padding-inline: 12px; }
        .adm-main { padding: 16px 12px 32px; }
        .adm-grid-2 { grid-template-columns: minmax(0, 1fr); }
      }
      @media (max-width: 640px) {
        .adm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
        .adm-card { padding: 14px; }
        .adm-card .num { font-size: 1.45rem; }
        .adm-brand { font-size: 0.95rem; }
        .adm-login-card { padding: 24px; }
        #adm-toast { inset-inline: 12px; bottom: 12px; max-width: none; }
        .adm-dialog { padding: 16px; }
        .adm-row .adm-btn { flex: 1 1 auto; }
      }
      /* touch devices: comfortable hit areas */
      @media (pointer: coarse) {
        .adm-btn-sm { min-height: 40px; }
        .adm-icon-btn { width: 42px; height: 42px; }
        .adm-nav a { min-height: 42px; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
    </style>
  </head>
  <body>
    <div id="adm-login" class="adm-login" hidden>
      <div class="adm-login-card">
        <h1>ورود مدیریت</h1>
        <p>توکن ادمین رو وارد کن. این توکن فقط روی همین تب مرورگر ذخیره می‌شه.</p>
        <form id="adm-login-form">
          <div class="adm-field">
            <label for="adm-token">توکن ادمین</label>
            <input id="adm-token" class="adm-input" type="password" dir="ltr" autocomplete="off" autocapitalize="off" spellcheck="false" />
          </div>
          <button id="adm-login-btn" class="adm-btn" type="submit" style="width:100%">ورود</button>
          <p id="adm-login-err" class="adm-login-err" role="alert" hidden></p>
        </form>
      </div>
    </div>

    <div id="adm-app" class:list={["adm-app", { "adm-app-fluid": fluid }]} hidden>
      <header class="adm-topbar">
        <div class="adm-brand">AHURA.DEV — مدیریت</div>
        <div class="adm-top-actions">
          <a class="adm-btn adm-btn-ghost adm-btn-sm" href={siteHome} target="_blank" rel="noopener">مشاهده سایت</a>
          <button id="adm-theme" class="adm-icon-btn" type="button" title="تغییر تم روشن/تیره" aria-label="تغییر تم">☾</button>
          <button id="adm-logout" class="adm-btn adm-btn-ghost adm-btn-sm" type="button">خروج</button>
        </div>
      </header>
      <nav class="adm-nav" aria-label="منوی مدیریت">
        {nav.map((n) => (
          <a href={n.href} class={n.id === page ? "active" : ""} aria-current={n.id === page ? "page" : undefined}>{n.label}</a>
        ))}
      </nav>
      <main class:list={["adm-main", { fluid }]}>
        <slot />
      </main>
    </div>

    <div id="adm-toast" role="status" aria-live="polite"></div>

    <script is:inline>
      (function () {
        "use strict";
        var API = "https://ahura-api.admine-070.workers.dev";
        var KEY = "ahura-admin-token";
        var THEME_KEY = "ahura-theme";
        var readyResolve;
        var ready = new Promise(function (res) { readyResolve = res; });
        var wasAuthed = false; // app already shown once in this page load

        function $(id) { return document.getElementById(id); }
        function esc(s) {
          return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
            return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
          });
        }
        function getToken() { try { return sessionStorage.getItem(KEY) || ""; } catch (e) { return ""; } }
        function setToken(v) {
          try { if (v) sessionStorage.setItem(KEY, v); else sessionStorage.removeItem(KEY); } catch (e) {}
        }

        /* ---------- errors: API codes -> Persian ---------- */
        var ERR = {
          unauthorized: "نشست منقضی شده؛ دوباره وارد شو.",
          network_error: "ارتباط با سرور برقرار نشد. اینترنت رو چک کن.",
          rate_limited: "تعداد درخواست‌ها زیاده؛ چند دقیقه صبر کن.",
          version_conflict: "این سند جای دیگه‌ای تغییر کرده.",
          version_required: "نسخه‌ی سند مشخص نیست؛ صفحه رو دوباره باز کن.",
          slug_taken: "این اسلاگ قبلاً برای سند دیگه‌ای استفاده شده.",
          invalid_slug: "اسلاگ نامعتبره — فقط حروف کوچک انگلیسی، عدد و خط‌تیره.",
          must_unpublish_first: "اول انتشار این نوشته رو لغو کن.",
          content_too_large: "حجم متن از حد مجاز (حدود ۱٫۵ مگابایت) بیشتره.",
          body_too_large: "حجم درخواست از حد مجاز بیشتره.",
          file_too_large: "حجم عکس از حد مجاز بیشتره.",
          invalid_image: "فایل، عکس معتبر (PNG/JPG/WebP/GIF) نیست.",
          too_many_files: "حداکثر ۵ فایل در هر بار.",
          no_files: "فایلی انتخاب نشده.",
          not_an_article: "فقط سندهای «مقاله» قابل انتشارند.",
          not_active: "فقط سند فعال قابل انتشاره.",
          not_published: "این سند منتشر نشده.",
          title_required: "عنوان لازمه.",
          empty_content: "متن سند خالیه.",
          title_and_subject_required: "عنوان و موضوع لازمن.",
          asset_in_use: "این عکس هنوز داخل یک نوشته استفاده شده.",
          invalid_state: "در این وضعیت امکان‌پذیر نیست.",
          email_provider_not_configured: "سرویس ایمیل پیکربندی نشده؛ ارسال ممکن نیست.",
          folder_not_found: "پوشه پیدا نشد.",
          search_failed: "جستجو ناموفق بود.",
          validation: "ورودی نامعتبره.",
          invalid_json: "درخواست نامعتبره.",
          not_found: "پیدا نشد.",
          not_implemented: "این قابلیت هنوز پیاده نشده.",
          internal_error: "خطای داخلی سرور؛ کمی بعد دوباره تلاش کن."
        };
        function errMsg(e) {
          var code = (e && (e.code || e.message)) || "";
          if (ERR[code]) return ERR[code];
          if (/^http_5/.test(code)) return ERR.internal_error;
          if (e && e.name === "TypeError") return ERR.network_error;
          return code ? "خطا: " + code : ERR.network_error;
        }
        function mkErr(code, status, data) {
          var e = new Error(code);
          e.code = code;
          e.status = status;
          e.data = data || null;
          if (data && data.current_version !== undefined) e.current_version = data.current_version;
          return e;
        }

        /* ---------- toast ---------- */
        function toast(msg, isErr) {
          var box = $("adm-toast");
          while (box.children.length >= 3) box.firstChild.remove();
          var d = document.createElement("div");
          d.className = "adm-toast-msg" + (isErr ? " err" : "");
          d.setAttribute("role", isErr ? "alert" : "status");
          d.textContent = msg;
          box.appendChild(d);
          setTimeout(function () { d.remove(); }, isErr ? 6500 : 3500);
        }

        /* ---------- auth ---------- */
        function showLogin(msg) {
          $("adm-app").hidden = true;
          $("adm-login").hidden = false;
          var e = $("adm-login-err");
          if (msg) { e.textContent = msg; e.hidden = false; } else { e.hidden = true; }
          setTimeout(function () { try { $("adm-token").focus(); } catch (x) {} }, 30);
        }
        function showApp() {
          $("adm-login").hidden = true;
          $("adm-app").hidden = false;
          wasAuthed = true;
          var a = document.querySelector(".adm-nav a.active");
          if (a && a.scrollIntoView) { try { a.scrollIntoView({ inline: "center", block: "nearest" }); } catch (e) {} }
        }
        /* "ok" | "bad" (401) | "error" (network / 429 / 5xx). Only "bad" may ever discard the token. */
        async function check(token) {
          try {
            var res = await fetch(API + "/api/admin/stats", { headers: { Authorization: "Bearer " + token } });
            if (res.ok) return "ok";
            if (res.status === 401) return "bad";
            return "error";
          } catch (e) { return "error"; }
        }

        async function api(path, opts) {
          opts = opts || {};
          var headers = { Authorization: "Bearer " + getToken() };
          var body;
          if (opts.body !== undefined && opts.body !== null) {
            headers["Content-Type"] = "application/json";
            body = JSON.stringify(opts.body);
          }
          var res;
          try {
            res = await fetch(API + path, { method: opts.method || "GET", headers: headers, body: body });
          } catch (e) { throw mkErr("network_error", 0); }
          if (res.status === 401) {
            setToken(null);
            showLogin("توکن نامعتبره یا منقضی شده. دوباره وارد شو.");
            throw mkErr("unauthorized", 401);
          }
          if (opts.raw && res.ok) return res;
          var ct = res.headers.get("content-type") || "";
          if (ct.indexOf("application/json") === -1) {
            if (!res.ok) throw mkErr("http_" + res.status, res.status);
            return res;
          }
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok) throw mkErr((data && data.error) || "http_" + res.status, res.status, data);
          return data;
        }

        /* ---------- theme ---------- */
        function isDark() { return document.documentElement.classList.contains("dark"); }
        function paintThemeBtn() {
          var b = $("adm-theme");
          if (b) b.textContent = isDark() ? "☀" : "☾";
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute("content", isDark() ? "#1c1a15" : "#f7efe4");
        }
        function setTheme(dark) {
          document.documentElement.classList.toggle("dark", !!dark);
          try { localStorage.setItem(THEME_KEY, dark ? "dark" : "light"); } catch (e) {}
          paintThemeBtn();
          window.dispatchEvent(new CustomEvent("adm-theme", { detail: { dark: !!dark } }));
        }

        /* ---------- dialogs ---------- */
        function trapTab(ov, e) {
          if (e.key !== "Tab") return;
          var f = ov.querySelectorAll("button, input, textarea, select, a[href], iframe");
          if (!f.length) return;
          var first = f[0], last = f[f.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
        function openOverlay(contentEl, opts, onClose) {
          opts = opts || {};
          var ov = document.createElement("div");
          ov.className = "adm-overlay";
          contentEl.classList.add("adm-dialog");
          if (opts.wide) contentEl.classList.add("wide");
          contentEl.setAttribute("role", "dialog");
          contentEl.setAttribute("aria-modal", "true");
          ov.appendChild(contentEl);
          var prev = document.activeElement;
          var closed = false;
          function close(val) {
            if (closed) return;
            closed = true;
            document.removeEventListener("keydown", onKey, true);
            ov.remove();
            if (prev && prev.focus) { try { prev.focus(); } catch (e) {} }
            if (onClose) onClose(val);
          }
          function onKey(e) {
            if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); close(undefined); }
            else trapTab(ov, e);
          }
          document.addEventListener("keydown", onKey, true);
          ov.addEventListener("mousedown", function (e) { if (e.target === ov) close(undefined); });
          document.body.appendChild(ov);
          return { el: contentEl, close: close };
        }
        function confirmDialog(message, o) {
          o = o || {};
          return new Promise(function (resolve) {
            var box = document.createElement("div");
            box.innerHTML = '<p class="adm-dialog-msg"></p><div class="adm-dialog-actions"><button type="button" class="adm-btn' + (o.danger ? " adm-btn-danger" : "") + '" data-ok></button><button type="button" class="adm-btn adm-btn-ghost" data-cancel></button></div>';
            box.querySelector(".adm-dialog-msg").textContent = message;
            box.querySelector("[data-ok]").textContent = o.okText || "تأیید";
            box.querySelector("[data-cancel]").textContent = o.cancelText || "انصراف";
            var h = openOverlay(box, {}, function (v) { resolve(v === true); });
            box.querySelector("[data-ok]").addEventListener("click", function () { h.close(true); });
            box.querySelector("[data-cancel]").addEventListener("click", function () { h.close(false); });
            box.querySelector(o.danger ? "[data-cancel]" : "[data-ok]").focus();
          });
        }
        function promptDialog(message, def, o) {
          o = o || {};
          return new Promise(function (resolve) {
            var box = document.createElement("form");
            box.innerHTML = '<p class="adm-dialog-msg"></p><div class="adm-field"><input class="adm-input" type="text" maxlength="' + (o.maxLength || 200) + '" autocomplete="off" /></div><div class="adm-dialog-actions"><button type="submit" class="adm-btn"></button><button type="button" class="adm-btn adm-btn-ghost" data-cancel></button></div>';
            box.querySelector(".adm-dialog-msg").textContent = message;
            var input = box.querySelector("input");
            input.value = def || "";
            box.querySelector("[type=submit]").textContent = o.okText || "تأیید";
            box.querySelector("[data-cancel]").textContent = o.cancelText || "انصراف";
            var h = openOverlay(box, {}, function (v) { resolve(typeof v === "string" ? v : null); });
            box.addEventListener("submit", function (e) { e.preventDefault(); h.close(input.value); });
            box.querySelector("[data-cancel]").addEventListener("click", function () { h.close(undefined); });
            input.focus();
            input.select();
          });
        }
        /* generic modal: returns { el, close }. `el` is the dialog element to fill. */
        function modal(o) {
          var box = document.createElement("div");
          return openOverlay(box, o || {});
        }

        /* ---------- formatting ---------- */
        var nf = new Intl.NumberFormat("fa-IR");
        function faNum(n) { n = Number(n); return isFinite(n) ? nf.format(n) : "—"; }
        function faDate(iso) {
          if (!iso) return "—";
          try { var d = new Date(iso); return isNaN(d) ? String(iso) : d.toLocaleDateString("fa-IR"); } catch (e) { return String(iso); }
        }
        function faDateTime(iso) {
          if (!iso) return "—";
          try { var d = new Date(iso); return isNaN(d) ? String(iso) : d.toLocaleString("fa-IR", { dateStyle: "medium", timeStyle: "short" }); } catch (e) { return String(iso); }
        }
        function faDay(ymd) {
          try { return new Intl.DateTimeFormat("fa-IR", { month: "short", day: "numeric", timeZone: "UTC" }).format(new Date(ymd + "T00:00:00Z")); } catch (e) { return ymd; }
        }
        function faBytes(n) {
          n = Number(n) || 0;
          if (n < 1024) return faNum(n) + " بایت";
          if (n < 1048576) return faNum(Math.round((n / 1024) * 10) / 10) + " کیلوبایت";
          return faNum(Math.round((n / 1048576) * 100) / 100) + " مگابایت";
        }
        var LABELS = {
          sub: { confirmed: "تأیید شده", pending_confirmation: "در انتظار تأیید", unsubscribed: "لغو شده", bounced: "برگشتی" },
          camp: { draft: "پیش‌نویس", sending: "در حال ارسال", sent: "ارسال شده", failed: "ناموفق" },
          doc: { note: "یادداشت", article: "مقاله", docs: "مستندات", research: "پژوهش", newsletter: "خبرنامه" },
          device: { desktop: "کامپیوتر", mobile: "موبایل", tablet: "تبلت", unknown: "نامشخص" }
        };
        function label(group, key) { return (LABELS[group] && LABELS[group][key]) || key; }

        /* ---------- small utilities ---------- */
        function debounce(fn, ms) {
          var t;
          return function () {
            var a = arguments, self = this;
            clearTimeout(t);
            t = setTimeout(function () { fn.apply(self, a); }, ms);
          };
        }
        /* latest-request-wins: guards against out-of-order responses */
        function seq() {
          var n = 0;
          return function () { var id = ++n; return function () { return id === n; }; };
        }
        async function copyText(text) {
          try { await navigator.clipboard.writeText(text); return true; } catch (e) {}
          try {
            var ta = document.createElement("textarea");
            ta.value = text;
            ta.setAttribute("readonly", "");
            ta.style.cssText = "position:fixed;top:-1000px;opacity:0";
            document.body.appendChild(ta);
            ta.select();
            var ok = document.execCommand("copy");
            ta.remove();
            return ok;
          } catch (e2) { return false; }
        }
        function download(content, name, mime) {
          var blob = content instanceof Blob ? content : new Blob([content], { type: mime || "application/octet-stream" });
          var a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = name;
          document.body.appendChild(a);
          a.click();
          setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1500);
        }
        function renderError(el, e) {
          if (e && e.message === "unauthorized") return;
          el.innerHTML = '<div class="adm-card"><div class="adm-error">' + esc(errMsg(e)) + "</div></div>";
        }

        /* ---------- table / pager / chart builders ---------- */
        /* cols: [{ label, key, fmt(v,row), html(row) [trusted markup], ltr, cls }] */
        function table(cols, rows, o) {
          o = o || {};
          if (!rows.length) return '<div class="adm-card"><div class="adm-empty">' + esc(o.empty || "داده‌ای نیست.") + "</div></div>";
          var h = '<div class="adm-card adm-table-wrap adm-tw"><table class="adm-table stack"><thead><tr>';
          cols.forEach(function (c) { h += "<th>" + esc(c.label) + "</th>"; });
          h += "</tr></thead><tbody>";
          rows.forEach(function (r) {
            h += "<tr>";
            cols.forEach(function (c) {
              var v;
              if (c.html) v = c.html(r);
              else {
                v = esc(c.fmt ? c.fmt(r[c.key], r) : r[c.key]);
                if (v === "") v = "—";
                else if (c.ltr) v = '<bdi dir="ltr">' + v + "</bdi>";
              }
              h += '<td data-label="' + esc(c.label) + '" class="' + (c.ltr ? "ltr " : "") + (c.cls || "") + '">' + v + "</td>";
            });
            h += "</tr>";
          });
          return h + "</tbody></table></div>";
        }
        function pager(page, pages, total, unit) {
          return '<div class="adm-pagination"><button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-pg="prev"' + (page <= 1 ? " disabled" : "") + ">قبلی</button>"
            + "<span>صفحه‌ی " + faNum(page) + " از " + faNum(pages) + " (" + faNum(total) + " " + esc(unit || "مورد") + ")</span>"
            + '<button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-pg="next"' + (page >= pages ? " disabled" : "") + ">بعدی</button></div>";
        }
        function bindPager(root, page, pages, go) {
          root.querySelectorAll("[data-pg]").forEach(function (b) {
            b.addEventListener("click", function () {
              var np = b.getAttribute("data-pg") === "prev" ? page - 1 : page + 1;
              if (np >= 1 && np <= pages) go(np);
            });
          });
        }
        function niceMax(v) {
          if (v <= 4) return Math.max(2, Math.ceil(v / 2) * 2);
          var p = Math.pow(10, Math.floor(Math.log10(v)));
          return Math.ceil(v / p) * p;
        }
        /* rows: [{ <labelKey>: "YYYY-MM-DD", <valueKey>: n }]. Tap/hover/focus a bar to read its value. */
        function barChart(el, rows, labelKey, valueKey, opts) {
          opts = opts || {};
          if (!rows || !rows.length) { el.innerHTML = '<div class="adm-empty">هنوز داده‌ای نیست.</div>'; return; }
          var unit = opts.unit || "بازدید";
          var raw = Math.max.apply(null, rows.map(function (r) { return Number(r[valueKey]) || 0; }).concat([1]));
          var max = niceMax(raw);
          function lab(r) { return faDay(r[labelKey]); }
          var bars = rows.map(function (r, i) {
            var v = Number(r[valueKey]) || 0;
            var pct = Math.max(0, Math.min(100, (v / max) * 100));
            return '<button type="button" class="adm-bar" data-i="' + i + '" aria-label="' + esc(lab(r) + ": " + faNum(v) + " " + unit) + '"><span style="height:' + pct.toFixed(1) + '%"></span></button>';
          }).join("");
          var mid = rows[Math.floor(rows.length / 2)];
          el.innerHTML = '<div class="adm-bars" role="group" aria-label="نمودار ' + esc(unit) + '">'
            + '<div class="adm-bars-y"><span>' + faNum(max) + "</span><span>" + faNum(max / 2) + "</span><span>۰</span></div>"
            + '<div class="adm-bars-plot">' + bars + "</div>"
            + '<div class="adm-bars-axis"><span>' + esc(lab(rows[0])) + "</span><span>" + esc(lab(mid)) + "</span><span>" + esc(lab(rows[rows.length - 1])) + "</span></div>"
            + '<div class="adm-bars-tip"></div></div>';
          var tip = el.querySelector(".adm-bars-tip");
          var btns = el.querySelectorAll(".adm-bar");
          function show(i) {
            btns.forEach(function (b) { b.classList.remove("on"); });
            if (btns[i]) btns[i].classList.add("on");
            var r = rows[i];
            tip.textContent = lab(r) + " — " + faNum(Number(r[valueKey]) || 0) + " " + unit;
          }
          btns.forEach(function (b) {
            var i = Number(b.getAttribute("data-i"));
            b.addEventListener("mouseenter", function () { show(i); });
            b.addEventListener("focus", function () { show(i); });
            b.addEventListener("click", function () { show(i); });
          });
          show(rows.length - 1);
        }

        /* ---------- wiring ---------- */
        $("adm-login-form").addEventListener("submit", async function (e) {
          e.preventDefault();
          var token = $("adm-token").value.trim() || getToken();
          if (!token) return;
          var btn = $("adm-login-btn");
          btn.disabled = true;
          var r = await check(token);
          btn.disabled = false;
          if (r === "bad") { showLogin("توکن اشتباهه."); return; }
          if (r === "error") { showLogin("ارتباط با سرور برقرار نشد یا سرور موقتاً در دسترس نیست. کمی بعد دوباره تلاش کن."); return; }
          setToken(token);
          $("adm-token").value = "";
          if (wasAuthed) { location.reload(); return; } // session expired mid-use: reload so the page refetches
          showApp();
          readyResolve();
        });
        $("adm-logout").addEventListener("click", function () { setToken(null); location.reload(); });
        $("adm-theme").addEventListener("click", function () { setTheme(!isDark()); });
        paintThemeBtn();

        var existing = getToken();
        if (existing) {
          check(existing).then(function (r) {
            if (r === "ok") { showApp(); readyResolve(); }
            else if (r === "bad") { setToken(null); showLogin(); }
            else { showLogin("ارتباط با سرور برقرار نشد. «ورود» رو بزن تا دوباره تلاش کنم."); }
          });
        } else {
          showLogin();
        }

        // Safety net: any failed API call nobody handled still tells the user why.
        window.addEventListener("unhandledrejection", function (ev) {
          var r = ev.reason;
          if (!r || typeof r !== "object" || (r.code === undefined && r.status === undefined)) return;
          ev.preventDefault();
          if (r.message === "unauthorized") return;
          toast(errMsg(r), true);
        });
        window.addEventListener("offline", function () { toast("اینترنت قطع شد.", true); });
        window.addEventListener("online", function () { toast("اینترنت وصل شد."); });

        window.AdminAPI = {
          API: API, api: api, ready: ready, toast: toast, esc: esc, errMsg: errMsg,
          confirm: confirmDialog, prompt: promptDialog, modal: modal,
          faNum: faNum, faDate: faDate, faDateTime: faDateTime, faDay: faDay, faBytes: faBytes, label: label,
          table: table, pager: pager, bindPager: bindPager, barChart: barChart,
          debounce: debounce, seq: seq, copyText: copyText, download: download, renderError: renderError,
          isDark: isDark, setTheme: setTheme
        };
      })();
    </script>
  </body>
</html>
