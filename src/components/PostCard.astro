---
import { faDate, type PostMeta } from '../lib/posts';import { withBase } from '../lib/posts';


interface Props {
  post: PostMeta;
}

const { post } = Astro.props;
---

<a class="slj-card" href={withBase(`/posts/${post.slug}/`)}>
  <span class="ph">
    <img src={post.image} alt="" loading="lazy" />
  </span>
  <h2>{post.title}</h2>
  <p>{post.description}</p>
  <time>{faDate(post.pubDate)}</time>
</a>
