---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';
import Sidebar from '../components/Sidebar.astro';import { withBase } from '../lib/posts';


interface Props {
  title: string;
  description?: string;
  withSidebar?: boolean;
  current?: 'home' | 'about';
  image?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  modDate?: string;
}

const {
  title,
  description = 'وبلاگ شخصی اهورا — یادداشت‌ها، تجربه‌ها و چیزهایی که یاد می‌گیرم.',
  withSidebar = true,
  current,
  image,
  type = 'website',
  pubDate,
  modDate,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ?? new URL(`${import.meta.env.BASE_URL}images/card-about.webp`, Astro.site).toString();
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="اهورا" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="ahura.dev" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && pubDate && <meta property="article:published_time" content={pubDate} />}
    {type === 'article' && (modDate ?? pubDate) && <meta property="article:modified_time" content={modDate ?? pubDate} />}
    {type === 'article' && <meta property="article:author" content="اهورا" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="ahura.dev — RSS" href={withBase('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // جلوگیری از چشمک‌زدن تم: قبل از رندر، تم ذخیره‌شده را اعمال کن
      (function () {
        try {
          const saved = localStorage.getItem('ahura-theme');
          if (saved !== 'light') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="slj-wrap">
      <div class="slj-cols">
        <div class="slj-maincol">
          <div class="slj-util">
            <nav aria-label="ناوبری اصلی">
              <a href={withBase("/")} aria-current={current === 'home' ? 'page' : undefined}>خانه</a>
              <a href={withBase("/about")} aria-current={current === 'about' ? 'page' : undefined}>درباره من</a>
            </nav>
            <ThemeToggle client:load />
          </div>

          {current === 'home' ? (
            <h1 class="slj-wordmark">
              <a href={withBase("/")}>Ahura.dev</a>
            </h1>
          ) : (
            <p class="slj-wordmark">
              <a href={withBase("/")}>Ahura.dev</a>
            </p>
          )}
          <hr class="slj-rule" />

          <main class="slj-main">
            <slot />
          </main>
          <footer class="slj-footer">
            ساخته شده توسط اهورا · <a href={withBase("/about")}>درباره من</a>
          </footer>
        </div>
        {withSidebar && <Sidebar />}
      </div>
    </div>
    <script is:inline>
      // Privacy-conscious first-party analytics: one page-view event per page load.
      // No IP storage, no fingerprinting, honors Do Not Track.
      // visitor = persistent per-browser id; session = rotated after 30 min of inactivity.
      (function () {
        try {
          if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;
          if (navigator.webdriver) return; // obvious automation: do not count
          var vid = null, sid = null, sidTs = 0;
          try {
            vid = localStorage.getItem("ahura-vid");
            if (!vid) {
              vid = newId();
              localStorage.setItem("ahura-vid", vid);
            }
            sid = localStorage.getItem("ahura-sid");
            sidTs = parseInt(localStorage.getItem("ahura-sid-ts") || "0", 10) || 0;
            if (!sid || Date.now() - sidTs > 30 * 60 * 1000) {
              sid = newId();
              localStorage.setItem("ahura-sid", sid);
            }
            localStorage.setItem("ahura-sid-ts", String(Date.now()));
          } catch (e) {
            return;
          }
          function newId() {
            return (
              (crypto.randomUUID && crypto.randomUUID()) ||
              "xxxxxxxx-xxxx-4xxx".replace(/x/g, function () {
                return ((Math.random() * 16) | 0).toString(16);
              })
            );
          }
          var eventId = newId();
          var w = Math.min(window.screen.width, window.innerWidth || 0);
          var ua = navigator.userAgent || "";
          var device = /Mobi|Android|iPhone|iPad|Mobile/i.test(ua) ? (w > 900 ? "tablet" : "mobile") : w > 0 && w < 768 ? "mobile" : "desktop";
          var params = new URLSearchParams(window.location.search);
          var payload = {
            event_id: eventId,
            session_id: sid,
            visitor_id: vid,
            path: window.location.pathname,
            referrer: document.referrer || null,
            utm_source: params.get("utm_source"),
            utm_medium: params.get("utm_medium"),
            utm_campaign: params.get("utm_campaign"),
            device: device,
          };
          var body = JSON.stringify(payload);
          var url = "https://ahura-api.admine-070.workers.dev/api/analytics";
          if (navigator.sendBeacon) {
            var blob = new Blob([body], { type: "application/json" });
            navigator.sendBeacon(url, blob);
          } else {
            fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: body, keepalive: true }).catch(function () {});
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
