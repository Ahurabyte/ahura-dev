---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';
import Sidebar from '../components/Sidebar.astro';import { withBase } from '../lib/posts';


interface Props {
  title: string;
  description?: string;
  withSidebar?: boolean;
  current?: 'home' | 'about';
}

const {
  title,
  description = 'وبلاگ شخصی اهورا — یادداشت‌ها، تجربه‌ها و چیزهایی که یاد می‌گیرم.',
  withSidebar = true,
  current,
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // جلوگیری از چشمک‌زدن تم: قبل از رندر، تم ذخیره‌شده را اعمال کن
      (function () {
        try {
          const saved = localStorage.getItem('ahura-theme');
          if (saved !== 'light') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="slj-wrap">
      <div class="slj-cols">
        <div class="slj-maincol">
          <div class="slj-util">
            <nav aria-label="ناوبری اصلی">
              <a href={withBase("/")} aria-current={current === 'home' ? 'page' : undefined}>خانه</a>
              <a href={withBase("/about")} aria-current={current === 'about' ? 'page' : undefined}>درباره من</a>
            </nav>
            <ThemeToggle client:load />
          </div>

          {current === 'home' ? (
            <h1 class="slj-wordmark">
              <a href={withBase("/")}>Ahura.dev</a>
            </h1>
          ) : (
            <p class="slj-wordmark">
              <a href={withBase("/")}>Ahura.dev</a>
            </p>
          )}
          <hr class="slj-rule" />

          <main class="slj-main">
            <slot />
          </main>
          <footer class="slj-footer">
            ساخته شده توسط اهورا · <a href={withBase("/about")}>درباره من</a>
          </footer>
        </div>
        {withSidebar && <Sidebar />}
      </div>
    </div>
    <script is:inline>
      // Privacy-conscious first-party analytics: one page-view event per page load.
      // No IP storage, no fingerprinting, honors Do Not Track.
      (function () {
        try {
          if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;
          var sid = null;
          try {
            sid = localStorage.getItem("ahura-sid");
            if (!sid) {
              sid =
                (crypto.randomUUID && crypto.randomUUID()) ||
                "xxxxxxxx-xxxx-4xxx".replace(/x/g, function () {
                  return ((Math.random() * 16) | 0).toString(16);
                });
              localStorage.setItem("ahura-sid", sid);
            }
          } catch (e) {
            return;
          }
          var eventId =
            (crypto.randomUUID && crypto.randomUUID()) || String(Date.now()) + "-" + Math.random().toString(16).slice(2);
          var w = Math.min(window.screen.width, window.innerWidth || 0);
          var ua = navigator.userAgent || "";
          var device = /Mobi|Android|iPhone|iPad|Mobile/i.test(ua) ? (w > 900 ? "tablet" : "mobile") : w > 0 && w < 768 ? "mobile" : "desktop";
          var params = new URLSearchParams(window.location.search);
          var payload = {
            event_id: eventId,
            session_id: sid,
            path: window.location.pathname,
            referrer: document.referrer || null,
            utm_source: params.get("utm_source"),
            utm_medium: params.get("utm_medium"),
            utm_campaign: params.get("utm_campaign"),
            device: device,
          };
          var body = JSON.stringify(payload);
          var url = "https://ahura-api.admine-070.workers.dev/api/analytics";
          if (navigator.sendBeacon) {
            var blob = new Blob([body], { type: "application/json" });
            navigator.sendBeacon(url, blob);
          } else {
            fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: body, keepalive: true }).catch(function () {});
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
