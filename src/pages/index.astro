---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';

const posts = getPosts();
---

<BaseLayout title="اهورا.dev — وبلاگ شخصی اهورا" current="home">
  <div class="slj-grid">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
