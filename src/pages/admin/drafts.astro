---
import AdminShell from "../../components/admin/AdminShell.astro";
import { withBase } from "../../lib/posts";
---

<AdminShell title="پیش‌نویس‌ها" page="drafts">
  <div class="adm-row">
    <input id="adm-q" class="adm-input" placeholder="جستجو در پیش‌نویس‌ها..." />
    <button id="adm-search" class="adm-btn">جستجو</button>
  </div>
  <div id="adm-drafts"><div class="adm-loading">در حال بارگذاری...</div></div>

  <script is:inline define:vars={{ writingBase: withBase("/admin/writing/") }}>
    /* Deferred to DOMContentLoaded: AdminShell defines window.AdminAPI in its own
       script, which runs AFTER this page script during parsing. */
    window.addEventListener("DOMContentLoaded", function () {
      var page = 1, perPage = 20;
      function fmtDate(iso) {
        if (!iso) return "—";
        try { return new Date(iso).toLocaleDateString("fa-IR"); } catch (e) { return iso; }
      }
      function load() {
        var A = window.AdminAPI;
        var root = document.getElementById("adm-drafts");
        var q = document.getElementById("adm-q").value.trim();
        var url = "/api/admin/documents?status=active&publish_state=draft&per_page=" + perPage + "&page=" + page
          + (q ? "&q=" + encodeURIComponent(q) : "");
        root.innerHTML = '<div class="adm-loading">در حال بارگذاری...</div>';
        A.api(url).then(function (res) {
          var rows = res.documents, total = res.total;
          var pages = Math.max(1, Math.ceil(total / perPage));
          var h = '<div class="adm-card adm-table-wrap">';
          if (!rows.length) {
            h += '<div class="adm-empty">پیش‌نویسی در کار نیست.</div>';
          } else {
            h += '<table class="adm-table"><tr><th>عنوان</th><th>نوع</th><th>اسلاگ</th><th>کلمه</th><th>آخرین تغییر</th><th>عملیات</th></tr>';
            rows.forEach(function (r) {
              h += "<tr><td><a href=\"" + writingBase + "?doc=" + r.id + "\">" + A.esc(r.title) + "</a></td>"
                + "<td>" + A.esc(r.document_type) + "</td>"
                + "<td dir='ltr' style='text-align:left'>" + A.esc(r.slug || "—") + "</td>"
                + "<td>" + Number(r.word_count || 0).toLocaleString("fa-IR") + "</td>"
                + "<td>" + fmtDate(r.updated_at) + "</td>"
                + '<td><div class="adm-row" style="margin:0">'
                + '<a class="adm-btn" href="' + writingBase + "?doc=" + r.id + '">ویرایش</a>'
                + (r.document_type === "article"
                    ? ' <button class="adm-btn adm-btn-ghost" data-pub="' + r.id + '">انتشار</button>'
                    : "")
                + ' <button class="adm-btn adm-btn-danger" data-del="' + r.id + '">حذف</button>'
                + "</div></td></tr>";
            });
            h += "</table>";
          }
          h += "</div>";
          h += '<div class="adm-pager"><button class="adm-btn adm-btn-ghost" id="pg-prev"' + (page <= 1 ? " disabled" : "") + ">قبلی</button>"
            + "<span>" + page + " از " + pages + " (" + total + ")</span>"
            + '<button class="adm-btn adm-btn-ghost" id="pg-next"' + (page >= pages ? " disabled" : "") + ">بعدی</button></div>";
          root.innerHTML = h;
          document.getElementById("pg-prev").onclick = function () { if (page > 1) { page--; load(); } };
          document.getElementById("pg-next").onclick = function () { if (page < pages) { page++; load(); } };
          root.querySelectorAll("[data-pub]").forEach(function (b) {
            b.onclick = function () {
              A.api("/api/admin/documents/" + b.dataset.pub + "/publish", { method: "POST", body: {} })
                .then(function () { A.toast("منتشر شد."); load(); })
                .catch(function (e) {
                  A.toast("انتشار ناموفق: " + (e.message || e) + " — برای اسلاگ و توضیح کوتاه، سند را در استودیو باز کن.", true);
                });
            };
          });
          root.querySelectorAll("[data-del]").forEach(function (b) {
            b.onclick = function () {
              if (!confirm("این پیش‌نویس به سطل زباله منتقل شود؟")) return;
              A.api("/api/admin/documents/" + b.dataset.del, { method: "DELETE" })
                .then(function () { A.toast("حذف شد."); load(); })
                .catch(function (e) { A.toast("خطا: " + (e.message || e), true); });
            };
          });
        }).catch(function (e) { root.innerHTML = '<div class="adm-card adm-empty">خطا: ' + A.esc(e.message || e) + "</div>"; });
      }
      document.getElementById("adm-search").onclick = function () { page = 1; load(); };
      document.getElementById("adm-q").addEventListener("keydown", function (e) { if (e.key === "Enter") { page = 1; load(); } });
      load();
    });
  </script>
</AdminShell>
