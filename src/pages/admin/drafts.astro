---
import AdminShell from "../../components/admin/AdminShell.astro";
import { withBase } from "../../lib/posts";
---

<AdminShell title="پیش‌نویس‌ها" page="drafts">
  <div class="adm-page-head">
    <h1>پیش‌نویس‌ها</h1>
    <a class="adm-btn" href={withBase("/admin/writing/?new=1")}>＋ نوشته‌ی جدید</a>
  </div>
  <div class="adm-row">
    <input id="adm-q" class="adm-input" placeholder="جستجو در پیش‌نویس‌ها..." type="search" />
    <select id="adm-type" class="adm-select" aria-label="نوع سند">
      <option value="">همه‌ی انواع</option>
      <option value="article">مقاله</option>
      <option value="note">یادداشت</option>
      <option value="docs">مستندات</option>
      <option value="research">پژوهش</option>
      <option value="newsletter">خبرنامه</option>
    </select>
    <select id="adm-sort" class="adm-select" aria-label="مرتب‌سازی">
      <option value="updated">آخرین تغییر</option>
      <option value="created">تاریخ ساخت</option>
      <option value="title">عنوان</option>
    </select>
    <button id="adm-search" class="adm-btn" type="button">جستجو</button>
  </div>
  <div id="adm-drafts"><div class="adm-loading">در حال بارگذاری...</div></div>

  <script is:inline define:vars={{ writingBase: withBase("/admin/writing/") }}>
    window.addEventListener("DOMContentLoaded", function () {
      window.AdminAPI.ready.then(function () {
        var A = window.AdminAPI, esc = A.esc;
        var page = 1, perPage = 20;
        var root = document.getElementById("adm-drafts");
        var guard = A.seq();

        function load() {
          var fresh = guard();
          var q = document.getElementById("adm-q").value.trim();
          var type = document.getElementById("adm-type").value;
          var url = "/api/admin/documents?status=active&publish_state=draft&per_page=" + perPage + "&page=" + page
            + "&sort=" + document.getElementById("adm-sort").value + (type ? "&type=" + type : "") + (q ? "&q=" + encodeURIComponent(q) : "");
          root.innerHTML = '<div class="adm-loading">در حال بارگذاری...</div>';
          A.api(url).then(function (res) {
            if (!fresh()) return;
            var rows = res.documents, total = res.total;
            var pages = Math.max(1, Math.ceil(total / perPage));
            if (!rows.length && page > 1) { page = pages; load(); return; }
            var h = A.table([
              { label: "عنوان", html: function (r) { return '<a href="' + writingBase + "?doc=" + r.id + '">' + (esc(r.title) || "بدون عنوان") + "</a>"; } },
              { label: "نوع", key: "document_type", fmt: function (v) { return A.label("doc", v); } },
              { label: "اسلاگ", key: "slug", ltr: true },
              { label: "کلمه", key: "word_count", fmt: A.faNum },
              { label: "آخرین تغییر", key: "updated_at", fmt: function (v) { return A.faDate(v); } },
              { label: "عملیات", cls: "adm-td-actions", html: function (r) {
                return '<div class="adm-row"><a class="adm-btn adm-btn-sm" href="' + writingBase + "?doc=" + r.id + '">ویرایش</a>'
                  + (r.document_type === "article" ? '<button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-pub="' + r.id + '">انتشار</button>' : "")
                  + '<button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-del="' + r.id + '">حذف</button></div>';
              } },
            ], rows, { empty: q || type ? "نتیجه‌ای پیدا نشد." : "پیش‌نویسی در کار نیست." });
            if (total > perPage) h += A.pager(page, pages, total, "پیش‌نویس");
            root.innerHTML = h;
            A.bindPager(root, page, pages, function (p) { page = p; load(); });
            root.querySelectorAll("[data-pub]").forEach(function (b) {
              b.addEventListener("click", async function () {
                try { await A.api("/api/admin/documents/" + b.getAttribute("data-pub") + "/publish", { method: "POST", body: {} }); A.toast("منتشر شد."); load(); }
                catch (e) { A.toast(A.errMsg(e) + " — برای اسلاگ و توضیح کوتاه، سند رو در استودیو باز کن.", true); }
              });
            });
            root.querySelectorAll("[data-del]").forEach(function (b) {
              b.addEventListener("click", async function () {
                if (!(await A.confirm("این پیش‌نویس به سطل زباله منتقل بشه؟", { danger: true, okText: "انتقال" }))) return;
                try { await A.api("/api/admin/documents/" + b.getAttribute("data-del"), { method: "DELETE" }); A.toast("حذف شد."); load(); }
                catch (e) { A.toast(A.errMsg(e), true); }
              });
            });
          }).catch(function (e) { if (fresh()) A.renderError(root, e); });
        }
        document.getElementById("adm-search").addEventListener("click", function () { page = 1; load(); });
        document.getElementById("adm-q").addEventListener("input", A.debounce(function () { page = 1; load(); }, 350));
        document.getElementById("adm-type").addEventListener("change", function () { page = 1; load(); });
        document.getElementById("adm-sort").addEventListener("change", function () { page = 1; load(); });
        load();
      });
    });
  </script>
</AdminShell>
