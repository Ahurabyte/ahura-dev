---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell title="تنظیمات" page="settings">
  <div id="adm-settings"><div class="adm-loading">در حال بارگذاری...</div></div>

  <script is:inline>
    (function () {
      window.AdminAPI.ready.then(function () {
        var A = window.AdminAPI;
        var root = document.getElementById("adm-settings");
        A.api("/api/admin/health").then(function (res) {
          var h = res.health;
          var rows = Object.keys(h.tables).map(function (t) {
            return "<tr><td dir='ltr' style='text-align:left'>" + A.esc(t) + "</td><td>" + h.tables[t] + "</td></tr>";
          }).join("");
          root.innerHTML =
            '<div class="adm-section"><h2>وضعیت سیستم</h2><div class="adm-card adm-table-wrap"><table class="adm-table">'
            + "<tr><th>مؤلفه</th><th>وضعیت</th></tr>"
            + "<tr><td>ارائه‌دهنده‌ی ایمیل</td><td><span class='adm-badge " + (h.email_sending ? "confirmed" : "pending_confirmation") + "'>" + A.esc(h.provider) + (h.email_sending ? " (فعال)" : " (غیرفعال)") + "</span></td></tr>"
            + "<tr><td>زمان سرور (UTC)</td><td dir='ltr' style='text-align:left'>" + A.esc(h.time) + "</td></tr>"
            + "</table></div></div>"
            + '<div class="adm-section"><h2>جدول‌های دیتابیس</h2><div class="adm-card adm-table-wrap"><table class="adm-table">'
            + "<tr><th>جدول</th><th>تعداد رکورد</th></tr>" + rows + "</table></div></div>"
            + '<div class="adm-section"><h2>امنیت</h2><div class="adm-card">'
            + "<p>احراز هویت با توکن ادمین (Bearer) انجام می‌شه که فقط در حافظه‌ی همین تب مرورگر نگه داشته می‌شه و با بستن تب پاک می‌شه.</p>"
            + "<p>برای چرخش توکن: یه توکن ۲۵۶ بیتی جدید بساز و با دستور زیر به‌عنوان سکرت Worker ست کن:</p>"
            + "<p dir='ltr' style='text-align:left'><code>wrangler secret put ADMIN_TOKEN</code></p>"
            + "<p>بعد از ست کردن، با توکن جدید وارد شو.</p>"
            + "</div></div>";
        }).catch(function (e) {
          if (e.message !== "unauthorized") root.innerHTML = '<div class="adm-error">خطا: ' + A.esc(e.message) + "</div>";
        });
      });
    })();
  </script>
</AdminShell>
