---
import AdminShell from "../../components/admin/AdminShell.astro";
import { withBase } from "../../lib/posts";
---

<AdminShell title="نوشته‌ها" page="posts">
  <div class="adm-page-head"><h1>نوشته‌های منتشرشده</h1></div>
  <div class="adm-row">
    <input id="adm-q" class="adm-input" placeholder="جستجو در نوشته‌ها..." type="search" />
    <select id="adm-sort" class="adm-select" aria-label="مرتب‌سازی">
      <option value="updated">آخرین تغییر</option>
      <option value="created">تاریخ ساخت</option>
      <option value="title">عنوان</option>
    </select>
    <button id="adm-search" class="adm-btn" type="button">جستجو</button>
  </div>
  <div id="adm-posts"><div class="adm-loading">در حال بارگذاری...</div></div>

  <script is:inline define:vars={{ writingBase: withBase("/admin/writing/"), siteBase: withBase("/") }}>
    window.addEventListener("DOMContentLoaded", function () {
      window.AdminAPI.ready.then(function () {
        var A = window.AdminAPI, esc = A.esc;
        var page = 1, perPage = 20;
        var root = document.getElementById("adm-posts");
        var guard = A.seq();

        function load() {
          var fresh = guard();
          var q = document.getElementById("adm-q").value.trim();
          var url = "/api/admin/documents?status=active&publish_state=published&per_page=" + perPage + "&page=" + page
            + "&sort=" + document.getElementById("adm-sort").value + (q ? "&q=" + encodeURIComponent(q) : "");
          root.innerHTML = '<div class="adm-loading">در حال بارگذاری...</div>';
          A.api(url).then(function (res) {
            if (!fresh()) return;
            var rows = res.documents, total = res.total;
            var pages = Math.max(1, Math.ceil(total / perPage));
            var h = A.table([
              { label: "عنوان", html: function (r) { return '<a href="' + writingBase + "?doc=" + r.id + '">' + (esc(r.title) || "بدون عنوان") + "</a>"; } },
              { label: "اسلاگ", key: "slug", ltr: true },
              { label: "آخرین تغییر", key: "updated_at", fmt: function (v) { return A.faDate(v); } },
              { label: "انتشار", key: "published_at", fmt: function (v) { return A.faDate(v); } },
              { label: "همگام‌سازی", html: function (r) { return r.sync_state === "dirty" ? '<span class="adm-badge pending_confirmation">در انتظار همگام‌سازی</span>' : '<span class="adm-badge confirmed">همگام</span>'; } },
              { label: "عملیات", cls: "adm-td-actions", html: function (r) {
                return '<div class="adm-row"><a class="adm-btn adm-btn-sm" href="' + writingBase + "?doc=" + r.id + '">ویرایش</a>'
                  + (r.slug ? '<a class="adm-btn adm-btn-ghost adm-btn-sm" href="' + siteBase + "posts/" + esc(r.slug) + '/" target="_blank" rel="noopener">مشاهده</a>' : "")
                  + '<button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-unpub="' + r.id + '">لغو انتشار</button></div>';
              } },
            ], rows, { empty: q ? "نتیجه‌ای پیدا نشد." : "نوشته‌ای منتشر نشده است." });
            if (total > perPage) h += A.pager(page, pages, total, "نوشته");
            root.innerHTML = h;
            A.bindPager(root, page, pages, function (p) { page = p; load(); });
            root.querySelectorAll("[data-unpub]").forEach(function (b) {
              b.addEventListener("click", async function () {
                if (!(await A.confirm("انتشار این نوشته لغو بشه؟ از سایت برداشته می‌شه.", { okText: "لغو انتشار" }))) return;
                try { await A.api("/api/admin/documents/" + b.getAttribute("data-unpub") + "/unpublish", { method: "POST", body: {} }); A.toast("به پیش‌نویس برگشت."); load(); }
                catch (e) { A.toast(A.errMsg(e), true); }
              });
            });
          }).catch(function (e) { if (fresh()) A.renderError(root, e); });
        }
        document.getElementById("adm-search").addEventListener("click", function () { page = 1; load(); });
        document.getElementById("adm-q").addEventListener("input", A.debounce(function () { page = 1; load(); }, 350));
        document.getElementById("adm-sort").addEventListener("change", function () { page = 1; load(); });
        load();
      });
    });
  </script>
</AdminShell>
