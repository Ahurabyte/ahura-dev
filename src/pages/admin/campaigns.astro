---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell title="کمپین‌ها" page="campaigns">
  <div class="adm-page-head"><h1>کمپین‌ها</h1></div>
  <div id="adm-provider-note"></div>
  <div class="adm-section">
    <h2 id="adm-form-title">کمپین جدید</h2>
    <div class="adm-card">
      <div class="adm-field"><label for="adm-c-title">عنوان (داخلی)</label><input id="adm-c-title" class="adm-input" maxlength="200" /></div>
      <div class="adm-field"><label for="adm-c-subject">موضوع ایمیل</label><input id="adm-c-subject" class="adm-input" dir="ltr" style="text-align:left" maxlength="200" /></div>
      <div class="adm-field"><label for="adm-c-html">متن HTML</label><textarea id="adm-c-html" class="adm-textarea"></textarea></div>
      <div class="adm-field"><label for="adm-c-text">متن ساده</label><textarea id="adm-c-text" class="adm-textarea" style="min-height:80px"></textarea></div>
      <div class="adm-row" style="margin:0">
        <button id="adm-c-save" class="adm-btn" type="button">ذخیره‌ی پیش‌نویس</button>
        <button id="adm-c-preview" class="adm-btn adm-btn-ghost" type="button">پیش‌نمایش</button>
        <button id="adm-c-cancel" class="adm-btn adm-btn-ghost" type="button" hidden>لغو ویرایش</button>
      </div>
    </div>
  </div>
  <div class="adm-section">
    <h2>همه‌ی کمپین‌ها</h2>
    <div id="adm-campaigns"><div class="adm-loading">در حال بارگذاری...</div></div>
  </div>

  <script is:inline>
    window.addEventListener("DOMContentLoaded", function () {
      window.AdminAPI.ready.then(function () {
        var A = window.AdminAPI, esc = A.esc;
        var editingId = null;
        var campaigns = [];
        var $ = function (id) { return document.getElementById(id); };

        /* The HTML is arbitrary (often pasted). It is shown inside a fully
           sandboxed iframe: no scripts, no access to this origin or the admin
           token. (The old window.open + document.write ran it on the admin origin.) */
        function preview(html) {
          var m = A.modal({ wide: true });
          m.el.innerHTML = '<h3>پیش‌نمایش</h3><iframe class="adm-preview-frame" sandbox="" title="پیش‌نمایش ایمیل"></iframe><div class="adm-dialog-actions" style="margin-top:12px"><button type="button" class="adm-btn adm-btn-ghost">بستن</button></div>';
          m.el.querySelector("iframe").srcdoc = '<base target="_blank"><div dir="auto">' + (html || "<p>(خالی)</p>") + "</div>";
          m.el.querySelector("button").addEventListener("click", function () { m.close(); });
        }
        function resetForm() {
          editingId = null;
          ["adm-c-title", "adm-c-subject", "adm-c-html", "adm-c-text"].forEach(function (i) { $(i).value = ""; });
          $("adm-form-title").textContent = "کمپین جدید";
          $("adm-c-save").textContent = "ذخیره‌ی پیش‌نویس";
          $("adm-c-cancel").hidden = true;
        }
        function startEdit(c) {
          editingId = c.id;
          $("adm-c-title").value = c.title || "";
          $("adm-c-subject").value = c.subject || "";
          $("adm-c-html").value = c.body_html || "";
          $("adm-c-text").value = c.body_text || "";
          $("adm-form-title").textContent = "ویرایش پیش‌نویس";
          $("adm-c-save").textContent = "به‌روزرسانی پیش‌نویس";
          $("adm-c-cancel").hidden = false;
          $("adm-form-title").scrollIntoView({ behavior: "smooth", block: "start" });
          $("adm-c-title").focus();
        }

        function load() {
          var root = $("adm-campaigns");
          Promise.all([A.api("/api/admin/campaigns"), A.api("/api/admin/health")]).then(function (res) {
            campaigns = res[0].campaigns;
            var health = res[1].health;
            $("adm-provider-note").innerHTML = health.email_sending ? "" : '<div class="adm-notice err"><strong>سرویس ایمیل فعال نیست.</strong> ارسال واقعی کمپین تا وقتی ارائه‌دهنده‌ی ایمیل پیکربندی نشده غیرفعاله. می‌تونی پیش‌نویس بسازی و ویرایش کنی.</div>';
            var h = A.table([
              { label: "عنوان", key: "title" },
              { label: "موضوع", key: "subject", ltr: true },
              { label: "وضعیت", html: function (c) { return '<span class="adm-badge ' + esc(c.status) + '">' + esc(A.label("camp", c.status)) + "</span>" + (c.error ? '<div class="adm-error" style="padding:4px 0;font-size:.8rem">' + esc(c.error) + "</div>" : ""); } },
              { label: "گیرندگان", key: "recipient_count", fmt: A.faNum },
              { label: "ارسال‌شده", key: "sent_count", fmt: A.faNum },
              { label: "ساخته‌شده", key: "created_at", fmt: function (v) { return A.faDateTime(v); } },
              { label: "عملیات", cls: "adm-td-actions", html: function (c) {
                var d = c.status === "draft";
                return '<div class="adm-row"><button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-preview="' + c.id + '">پیش‌نمایش</button>'
                  + (d ? '<button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-edit="' + c.id + '">ویرایش</button>' : "")
                  + (d ? '<button type="button" class="adm-btn adm-btn-sm" data-send="' + c.id + '">ارسال</button>' : "")
                  + (d ? '<button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-del="' + c.id + '">حذف</button>' : "") + "</div>";
              } },
            ], campaigns, { empty: "هنوز کمپینی ساخته نشده." });
            root.innerHTML = h;
            function byId(b, a) { return campaigns.find(function (x) { return String(x.id) === b.getAttribute(a); }); }
            root.querySelectorAll("[data-preview]").forEach(function (b) { b.addEventListener("click", function () { preview(byId(b, "data-preview").body_html); }); });
            root.querySelectorAll("[data-edit]").forEach(function (b) { b.addEventListener("click", function () { startEdit(byId(b, "data-edit")); }); });
            root.querySelectorAll("[data-del]").forEach(function (b) {
              b.addEventListener("click", async function () {
                if (!(await A.confirm("این پیش‌نویس حذف بشه؟ این عمل برگشت‌ناپذیره.", { danger: true, okText: "حذف" }))) return;
                try { await A.api("/api/admin/campaigns/" + b.getAttribute("data-del"), { method: "DELETE" }); A.toast("حذف شد."); if (String(editingId) === b.getAttribute("data-del")) resetForm(); load(); }
                catch (e) { A.toast(A.errMsg(e), true); }
              });
            });
            root.querySelectorAll("[data-send]").forEach(function (b) {
              b.addEventListener("click", async function () {
                if (!(await A.confirm("این کمپین برای همه‌ی مشترکین تأییدشده ارسال بشه؟ این عمل برگشت‌ناپذیره.", { danger: true, okText: "ارسال" }))) return;
                try { await A.api("/api/admin/campaigns/" + b.getAttribute("data-send") + "/send", { method: "POST" }); A.toast("ارسال شد."); load(); }
                catch (e) { A.toast(A.errMsg(e), true); }
              });
            });
          }).catch(function (e) { A.renderError(root, e); });
        }

        $("adm-c-preview").addEventListener("click", function () { preview($("adm-c-html").value); });
        $("adm-c-cancel").addEventListener("click", resetForm);
        $("adm-c-save").addEventListener("click", async function () {
          var title = $("adm-c-title").value.trim(), subject = $("adm-c-subject").value.trim();
          if (!title || !subject) { A.toast("عنوان و موضوع لازمن.", true); return; }
          var body = { title: title, subject: subject, body_html: $("adm-c-html").value, body_text: $("adm-c-text").value };
          var btn = $("adm-c-save");
          btn.disabled = true;
          try {
            if (editingId) await A.api("/api/admin/campaigns/" + editingId, { method: "PUT", body: body });
            else await A.api("/api/admin/campaigns", { method: "POST", body: body });
            A.toast(editingId ? "پیش‌نویس به‌روز شد." : "پیش‌نویس ذخیره شد.");
            resetForm();
            load();
          } catch (e) { A.toast(A.errMsg(e), true); }
          finally { btn.disabled = false; }
        });
        load();
      });
    });
  </script>
</AdminShell>
