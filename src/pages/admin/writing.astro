---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell title="استودیو نوشتن" page="writing" fluid>
  <div id="studio" class="studio" hidden>
    <!-- ============ LEFT: documents ============ -->
    <aside class="studio-left" id="studioLeft">
      <button id="btnCloseLeft" class="st-panel-close" title="بستن پنل" aria-label="بستن پنل">×</button>
      <div class="st-left-actions">
        <button id="btnNewDoc" class="adm-btn st-new-btn">＋ سند جدید</button>
        <button id="btnImport" class="adm-btn adm-btn-ghost" title="وارد کردن فایل Markdown">وارد کردن</button>
      </div>
      <input id="docSearch" class="adm-input st-search" placeholder="جستجو در عنوان و متن..." autocomplete="off" />
      <div class="st-filter-row">
        <select id="filterType" class="adm-input st-select" title="نوع سند">
          <option value="">همه‌ی نوع‌ها</option>
          <option value="note">یادداشت</option>
          <option value="article">مقاله</option>
          <option value="docs">مستندات فنی</option>
          <option value="research">یادداشت پژوهشی</option>
          <option value="newsletter">پیش‌نویس خبرنامه</option>
        </select>
        <select id="filterStatus" class="adm-input st-select" title="وضعیت">
          <option value="active">فعال</option>
          <option value="archived">بایگانی‌شده</option>
          <option value="trashed">سطل زباله</option>
        </select>
        <select id="filterSort" class="adm-input st-select" title="مرتب‌سازی">
          <option value="updated">آخرین تغییر</option>
          <option value="created">تاریخ ساخت</option>
          <option value="title">عنوان</option>
        </select>
      </div>
      <div class="st-folders-head">
        <span>پوشه‌ها</span>
        <button id="btnNewFolder" class="st-mini-btn" title="پوشه‌ی جدید">＋</button>
      </div>
      <div id="folderList" class="st-folders"></div>
      <div id="docList" class="st-docs"></div>
      <button id="btnLoadMore" class="adm-btn adm-btn-ghost adm-btn-sm st-loadmore" type="button" hidden>نمایش بیشتر</button>
      <div id="docListEmpty" class="st-empty" hidden>
        <p>هنوز سندی نیست.</p>
        <p class="st-empty-sub">«سند جدید» رو بزن و شروع کن به نوشتن.</p>
      </div>
    </aside>

    <!-- ============ CENTER: editor ============ -->
    <main class="studio-center" id="studioCenter">
      <div class="st-topbar">
        <button id="btnToggleLeft" class="st-icon-btn" title="نمایش/پنهان کردن فهرست اسناد">☰</button>
        <input id="docTitle" class="st-title-input" placeholder="عنوان سند..." autocomplete="off" />
        <span id="saveStatus" class="st-save-status" title="وضعیت ذخیره‌سازی"></span>
        <div class="st-modes" id="modeSwitcher" title="حالت ویرایش">
          <button data-mode="wysiwyg" title="WYSIWYG — ویرایش مستقیم قالب‌بندی‌شده">WYSIWYG</button>
          <button data-mode="ir" title="Instant Rendering — رندر آنی مثل Typora">IR</button>
          <button data-mode="sv" title="Split View — کد و پیش‌نمایش کنار هم">Split</button>
        </div>
        <button id="btnFocus" class="st-icon-btn" title="حالت تمرکز (پنهان کردن پنل‌ها)">◉</button>
        <div class="st-menu-wrap">
          <button id="btnMore" class="st-icon-btn" title="ابزارهای بیشتر">⋯</button>
          <div id="moreMenu" class="st-menu" hidden>
            <button data-act="export-md">دانلود Markdown</button>
            <button data-act="copy-md">کپی سورس Markdown</button>
            <button data-act="copy-html">کپی به‌صورت HTML</button>
            <button data-act="print">چاپ / PDF</button>
            <button data-act="manual-save">ذخیره‌ی دستی (ساخت ریویژن)</button>
          </div>
        </div>
        <button id="btnToggleRight" class="st-icon-btn" title="نمایش/پنهان کردن پنل اطلاعات">◧</button>
      </div>
      <div id="conflictBanner" class="st-conflict" hidden></div>
      <div id="recoveryBanner" class="st-recovery" hidden></div>
      <div id="vditor" class="st-vditor" dir="ltr"></div>
      <div id="studioWelcome" class="st-welcome" hidden>
        <h2>استودیو نوشتن</h2>
        <p>یک سند رو از فهرست انتخاب کن یا سند جدید بساز.</p>
        <button id="btnWelcomeNew" class="adm-btn" type="button">＋ سند جدید</button>
      </div>
    </main>

    <!-- ============ RIGHT: stats & meta ============ -->
    <aside class="studio-right" id="studioRight">
      <button id="btnCloseRight" class="st-panel-close" title="بستن پنل" aria-label="بستن پنل">×</button>
      <div class="st-right-section">
        <h3>آمار سند</h3>
        <div id="docStats" class="st-stats">
          <div><span>کلمات</span><b id="statWords">۰</b></div>
          <div><span>نویسه‌ها</span><b id="statChars">۰</b></div>
          <div><span>نویسه‌ها (بدون فاصله)</span><b id="statCharsNoSpace">۰</b></div>
          <div><span>پاراگراف‌ها</span><b id="statParas">۰</b></div>
          <div><span>تیترها</span><b id="statHeadings">۰</b></div>
          <div><span>زمان مطالعه</span><b id="statReading">۰ دقیقه</b></div>
        </div>
      </div>
      <div class="st-right-section">
        <h3>مشخصات</h3>
        <div class="st-meta">
          <label>نوع سند
            <select id="metaType" class="adm-input">
              <option value="note">یادداشت</option>
              <option value="article">مقاله</option>
              <option value="docs">مستندات فنی</option>
              <option value="research">یادداشت پژوهشی</option>
              <option value="newsletter">پیش‌نویس خبرنامه</option>
            </select>
          </label>
          <label>پوشه
            <select id="metaFolder" class="adm-input"><option value="">بدون پوشه</option></select>
          </label>
          <label>برچسب‌ها (با ویرگول جدا کن)
            <input id="metaTags" class="adm-input" placeholder="مثلاً: ایده، پیش‌نویس" autocomplete="off" />
          </label>
          <div class="st-meta-row">
            <button id="btnPin" class="adm-btn adm-btn-ghost st-small">سنجاق</button>
            <button id="btnDuplicate" class="adm-btn adm-btn-ghost st-small">تکثیر</button>
          </div>
          <div class="st-meta-row">
            <button id="btnArchive" class="adm-btn adm-btn-ghost st-small">بایگانی</button>
            <button id="btnTrash" class="adm-btn adm-btn-ghost st-small st-danger">حذف</button>
          </div>
          <div class="st-doc-info" id="docInfo"></div>
        </div>
      </div>
      <div class="st-right-section" id="publishSection" hidden>
        <h3>انتشار</h3>
        <div class="st-pub-row">
          <span class="st-badge st-badge-draft" id="pubBadge">پیش‌نویس</span>
          <span class="st-sync-hint" id="pubSyncHint"></span>
        </div>
        <label class="st-field st-field-spaced"><span>اسلاگ (آدرس پست)</span>
          <input id="slugInput" class="adm-input" dir="ltr" placeholder="my-post-slug">
        </label>
        <label class="st-field st-field-spaced"><span>توضیح کوتاه (متا و خلاصه)</span>
          <textarea id="excerptInput" class="adm-input" rows="3" placeholder="یک یا دو جمله درباره‌ی پست"></textarea>
        </label>
        <div class="st-meta-actions">
          <button id="btnPublish" class="adm-btn" type="button">انتشار</button>
          <button id="btnUnpublish" class="adm-btn adm-btn-danger" type="button" hidden>لغو انتشار</button>
        </div>
        <p class="st-pub-note">«انتشار» سند را به بخش نوشته‌ها می‌برد؛ برای رفتن روی سایت، همگام‌سازی گیت لازم است.</p>
      </div>
      <div class="st-right-section">
        <h3>تاریخچه‌ی نسخه‌ها</h3>
        <div id="revisionList" class="st-revisions"><div class="st-empty-sub">نسخه‌ای ثبت نشده.</div></div>
      </div>
    </aside>
    <div id="studioBackdrop" class="st-backdrop" hidden></div>
  </div>

  <input type="file" id="importFile" accept=".md,.markdown,.txt,text/markdown" hidden />

  <div id="revisionModal" class="st-modal" hidden>
    <div class="st-modal-card">
      <h3>پیش‌نمایش نسخه</h3>
      <div class="st-modal-meta" id="revisionMeta"></div>
      <pre class="st-modal-preview" id="revisionPreview" dir="auto"></pre>
      <div class="st-modal-actions">
        <button id="revisionRestore" class="adm-btn">بازیابی این نسخه</button>
        <button id="revisionClose" class="adm-btn adm-btn-ghost">بستن</button>
      </div>
      <p class="st-empty-sub">بازیابی، محتوای فعلی رو به‌عنوان نسخه‌ی جدید ذخیره می‌کنه؛ چیزی گم نمی‌شه.</p>
    </div>
  </div>

  <script>
    import { initStudio } from "../../lib/studio.ts";
    initStudio();
  </script>

  <style is:global>
    /* The studio fills whatever is left under the admin bars: AdminShell's frame is
       exactly one viewport tall (100dvh) for fluid pages, so no calc(100vh - Npx)
       guess is needed (the old value ignored the nav bar and overflowed the screen).
       Colors come from the shell's variables, so light/dark always match. */
    .studio {
      --st-left-w: 290px;
      --st-right-w: 270px;
      display: flex;
      flex: 1 1 auto;
      width: 100%;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      background: var(--adm-bg);
      color: var(--adm-text);
    }
    .studio[hidden] { display: none; }

    /* ---------- left panel ---------- */
    .studio-left {
      width: var(--st-left-w);
      flex: 0 0 var(--st-left-w);
      border-inline-end: 1px solid var(--adm-border);
      background: var(--adm-panel);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: margin 0.2s ease, visibility 0.2s ease;
    }
    .studio.left-collapsed .studio-left { margin-inline-start: calc(-1 * var(--st-left-w)); visibility: hidden; }
    .st-left-actions { display: flex; gap: 8px; padding: 12px; }
    .st-new-btn { flex: 1; }
    .st-search { margin: 0 12px 8px; width: auto; }
    .st-filter-row { display: flex; gap: 6px; padding: 0 12px 8px; flex-wrap: wrap; }
    .st-select { flex: 1 1 80px; min-width: 0; width: auto; min-height: 36px; padding: 4px 8px; font-size: 0.85rem; }
    .st-folders-head { display: flex; justify-content: space-between; align-items: center; padding: 4px 14px; font-size: 0.8rem; font-weight: 700; color: var(--adm-muted); }
    .st-mini-btn { border: 1px solid var(--adm-border); background: none; border-radius: 6px; width: 28px; height: 28px; cursor: pointer; color: inherit; font-size: 1rem; line-height: 1; }
    .st-folders { padding: 0 8px 4px; max-height: 150px; overflow-y: auto; flex: 0 0 auto; }
    .st-folder { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; border-radius: 8px; cursor: pointer; font-size: 0.88rem; min-height: 32px; }
    .st-folder:hover { background: var(--adm-hover); }
    .st-folder.active { background: var(--adm-hover); font-weight: 700; box-shadow: inset 0 0 0 1px var(--adm-border); }
    .st-folder .st-count { color: var(--adm-muted); font-size: 0.78rem; }
    .st-docs { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 4px 8px 12px; }
    .st-loadmore { margin: 0 12px 12px; flex: 0 0 auto; }
    .st-doc { padding: 9px 10px; border-radius: 10px; cursor: pointer; margin-bottom: 4px; border: 1px solid transparent; }
    .st-doc:hover { background: var(--adm-hover); }
    .st-doc.active { border-color: var(--adm-border); background: var(--adm-hover); }
    .st-doc-title { font-weight: 700; font-size: 0.92rem; display: flex; gap: 6px; align-items: center; min-width: 0; }
    .st-doc-title > span:not(.pin):not(.dirty-dot):not(.st-pub-chip) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .st-doc-title .pin { color: var(--adm-focus); }
    .st-doc-title .dirty-dot { color: var(--adm-err); font-size: 1.2em; line-height: 0; }
    .st-doc-meta { font-size: 0.76rem; color: var(--adm-muted); margin-top: 3px; display: flex; gap: 8px; flex-wrap: wrap; }
    .st-doc-actions { display: none; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
    .st-doc.active .st-doc-actions { display: flex; }
    .st-doc-actions button { font-size: 0.74rem; padding: 4px 10px; min-height: 28px; border-radius: 6px; cursor: pointer; border: 1px solid var(--adm-border); background: none; color: inherit; font-family: inherit; }
    .st-empty { padding: 30px 16px; text-align: center; color: var(--adm-muted); }
    .st-empty-sub { font-size: 0.82rem; color: var(--adm-muted); }

    /* ---------- center ---------- */
    .studio-center { flex: 1 1 0; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
    .st-topbar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--adm-border); background: var(--adm-panel); flex: 0 0 auto; }
    .st-icon-btn { border: 1px solid var(--adm-border); background: none; border-radius: 8px; width: 36px; height: 36px; cursor: pointer; color: inherit; font-size: 1.05rem; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; padding: 0; }
    .st-icon-btn:hover { background: var(--adm-hover); }
    .st-icon-btn.on { background: var(--adm-accent); color: var(--adm-on-accent); border-color: var(--adm-accent); }
    .st-title-input { flex: 1 1 120px; min-width: 0; font-size: 1.15rem; font-weight: 800; font-family: inherit; border: none; background: none; color: inherit; padding: 6px 4px; outline: none; border-bottom: 2px solid transparent; }
    .st-title-input:focus { border-bottom-color: var(--adm-focus); }
    .st-save-status { font-size: 0.78rem; color: var(--adm-muted); white-space: nowrap; min-width: 90px; text-align: center; }
    .st-save-status.saving { color: var(--adm-focus); }
    .st-save-status.saved { color: var(--adm-ok); }
    .st-save-status.error { color: var(--adm-err); }
    .st-modes { display: flex; border: 1px solid var(--adm-border); border-radius: 8px; overflow: hidden; flex: 0 0 auto; }
    .st-modes button { border: none; background: none; color: inherit; padding: 8px 10px; cursor: pointer; font-size: 0.75rem; font-weight: 700; font-family: inherit; }
    .st-modes button + button { border-inline-start: 1px solid var(--adm-border); }
    .st-modes button.on { background: var(--adm-accent); color: var(--adm-on-accent); }
    .st-menu-wrap { position: relative; }
    .st-menu { position: absolute; inset-inline-end: 0; top: 42px; z-index: 60; min-width: 210px; background: var(--adm-panel); border: 1px solid var(--adm-border); border-radius: 10px; padding: 6px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18); }
    .st-menu[hidden] { display: none; }
    .st-menu button { display: block; width: 100%; text-align: start; border: none; background: none; color: inherit; padding: 9px 10px; border-radius: 6px; cursor: pointer; font-size: 0.88rem; font-family: inherit; }
    .st-menu button:hover { background: var(--adm-hover); }
    .st-conflict, .st-recovery { padding: 10px 16px; font-size: 0.88rem; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; flex: 0 0 auto; }
    .st-conflict[hidden], .st-recovery[hidden] { display: none; }
    .st-conflict { background: #fbe3e3; color: #7a1f1f; border-bottom: 1px solid #e5b4b4; }
    html.dark .st-conflict { background: #4a2323; color: #f3c1c1; border-color: #6b3232; }
    .st-recovery { background: #fdf3d8; color: #6b5312; border-bottom: 1px solid #e8d48a; }
    html.dark .st-recovery { background: #4a3d1c; color: #f0dfa8; border-color: #6b5a2a; }
    .st-conflict button, .st-recovery button { border: 1px solid currentColor; background: none; color: inherit; border-radius: 6px; padding: 5px 12px; min-height: 32px; cursor: pointer; font-size: 0.82rem; font-family: inherit; }
    .st-vditor { flex: 1 1 0; min-height: 0; overflow: hidden; }
    .st-vditor[hidden] { display: none; }
    .st-vditor .vditor { border: none !important; height: 100%; }
    .st-welcome { margin: auto; text-align: center; color: var(--adm-muted); padding: 40px 20px; }
    .st-welcome[hidden] { display: none; }
    .st-welcome h2 { font-size: 1.6rem; margin-bottom: 8px; color: var(--adm-text); }

    /* Vditor: per-paragraph direction (unicode-bidi: plaintext) so Persian paragraphs
       are RTL and English/code paragraphs LTR without any manual switching. */
    .st-vditor .vditor-wysiwyg, .st-vditor .vditor-ir { direction: rtl; }
    .st-vditor .vditor-wysiwyg pre, .st-vditor .vditor-ir pre,
    .st-vditor .vditor-preview { direction: ltr; }
    .st-vditor .vditor-sv { direction: ltr; unicode-bidi: plaintext; text-align: start; }
    .st-vditor .vditor-preview { text-align: start; }
    .st-vditor .vditor-preview p, .st-vditor .vditor-preview li, .st-vditor .vditor-preview blockquote,
    .st-vditor .vditor-preview h1, .st-vditor .vditor-preview h2, .st-vditor .vditor-preview h3,
    .st-vditor .vditor-preview h4, .st-vditor .vditor-preview h5, .st-vditor .vditor-preview h6,
    .st-vditor .vditor-wysiwyg p, .st-vditor .vditor-wysiwyg li, .st-vditor .vditor-wysiwyg blockquote,
    .st-vditor .vditor-wysiwyg h1, .st-vditor .vditor-wysiwyg h2, .st-vditor .vditor-wysiwyg h3,
    .st-vditor .vditor-wysiwyg h4, .st-vditor .vditor-wysiwyg h5, .st-vditor .vditor-wysiwyg h6,
    .st-vditor .vditor-ir p, .st-vditor .vditor-ir li, .st-vditor .vditor-ir blockquote,
    .st-vditor .vditor-ir h1, .st-vditor .vditor-ir h2, .st-vditor .vditor-ir h3,
    .st-vditor .vditor-ir h4, .st-vditor .vditor-ir h5, .st-vditor .vditor-ir h6,
    .st-vditor .vditor-ir__node { unicode-bidi: plaintext; text-align: start; }
    .st-vditor .vditor-preview pre, .st-vditor .vditor-preview code { direction: ltr; text-align: left; unicode-bidi: normal; }
    .st-vditor .vditor-toolbar { direction: ltr; }
    .st-vditor .vditor-reset img { max-width: 100%; height: auto; }

    /* focus mode */
    .studio.focus .studio-left, .studio.focus .studio-right { display: none; }
    .studio.focus .st-topbar .st-icon-btn:not(#btnFocus):not(#btnToggleLeft):not(#btnToggleRight),
    .studio.focus .st-topbar .st-menu-wrap { display: none; }
    .studio.focus .st-vditor { max-width: 860px; margin: 0 auto; width: 100%; }

    /* ---------- right panel ---------- */
    .studio-right { width: var(--st-right-w); flex: 0 0 var(--st-right-w); border-inline-start: 1px solid var(--adm-border); background: var(--adm-panel); overflow-y: auto; padding: 14px; transition: margin 0.2s ease, visibility 0.2s ease; }
    .studio.right-collapsed .studio-right { margin-inline-end: calc(-1 * var(--st-right-w)); visibility: hidden; }
    .st-panel-close { display: none; position: absolute; top: 8px; inset-inline-end: 10px; z-index: 5; width: 36px; height: 36px; border-radius: 8px; cursor: pointer; border: 1px solid var(--adm-border); background: var(--adm-panel); color: inherit; font-size: 1.25rem; line-height: 1; align-items: center; justify-content: center; padding: 0; }
    .st-backdrop { position: fixed; inset: 0; z-index: 150; background: rgba(0, 0, 0, 0.4); }
    .st-backdrop[hidden] { display: none; }
    .st-right-section { margin-bottom: 22px; }
    .st-right-section h3 { font-size: 0.85rem; margin: 0 0 10px; color: var(--adm-muted); }
    .st-pub-row { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
    .st-badge { font-size: 0.72rem; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--adm-border); }
    .st-badge-draft { background: #f3ead8; color: #7a6a3f; }
    .st-badge-pub { background: #dcead9; color: #3d6136; }
    html.dark .st-badge-draft { background: #4a4025; color: #d8c78f; }
    html.dark .st-badge-pub { background: #2f4429; color: #a9cfa0; }
    .st-sync-hint { font-size: 0.74rem; color: var(--adm-muted); }
    .st-field { display: block; margin-top: 10px; font-size: 0.82rem; }
    .st-field > span { display: block; margin-bottom: 4px; color: var(--adm-muted); }
    .st-field .adm-input { min-height: 38px; }
    .st-meta-actions { display: flex; gap: 8px; margin-top: 12px; }
    .st-meta-actions .adm-btn { flex: 1; }
    .st-pub-note { font-size: 0.74rem; color: var(--adm-muted); margin-top: 10px; line-height: 1.7; }
    .st-pub-chip { background: #dcead9; color: #3d6136; border-radius: 999px; padding: 0 7px; font-size: 0.66rem; flex: 0 0 auto; }
    html.dark .st-pub-chip { background: #2f4429; color: #a9cfa0; }
    .st-stats div { display: flex; justify-content: space-between; font-size: 0.86rem; padding: 5px 0; border-bottom: 1px dashed var(--adm-border); }
    .st-stats b { font-variant-numeric: tabular-nums; }
    .st-meta label { display: block; font-size: 0.82rem; margin-bottom: 10px; }
    .st-meta .adm-input { width: 100%; margin-top: 4px; min-height: 38px; }
    .st-meta-row { display: flex; gap: 8px; margin-bottom: 8px; }
    .st-small { flex: 1; font-size: 0.8rem; padding: 6px; min-height: 36px; }
    .st-danger { color: var(--adm-err) !important; border-color: var(--adm-err) !important; }
