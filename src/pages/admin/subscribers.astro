---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell title="مشترکین" page="subscribers">
  <div class="adm-page-head"><h1>مشترکین</h1></div>
  <div class="adm-row">
    <input id="adm-q" class="adm-input" placeholder="جستجو در ایمیل..." dir="ltr" style="text-align:left" type="search" />
    <select id="adm-status" class="adm-select" aria-label="وضعیت">
      <option value="">همه‌ی وضعیت‌ها</option>
      <option value="confirmed">تأیید شده</option>
      <option value="pending_confirmation">در انتظار تأیید</option>
      <option value="unsubscribed">لغو شده</option>
      <option value="bounced">برگشتی</option>
    </select>
    <button id="adm-search" class="adm-btn" type="button">جستجو</button>
    <button id="adm-export" class="adm-btn adm-btn-ghost" type="button">خروجی CSV</button>
  </div>
  <div id="adm-subs"><div class="adm-loading">در حال بارگذاری...</div></div>

  <script is:inline>
    window.addEventListener("DOMContentLoaded", function () {
      window.AdminAPI.ready.then(function () {
        var A = window.AdminAPI, esc = A.esc;
        var page = 1, perPage = 20;
        var root = document.getElementById("adm-subs");
        var guard = A.seq();
        function qs() { return { q: document.getElementById("adm-q").value.trim(), status: document.getElementById("adm-status").value }; }

        function load() {
          var fresh = guard(), f = qs();
          var url = "/api/admin/subscribers?page=" + page + "&per_page=" + perPage
            + (f.q ? "&q=" + encodeURIComponent(f.q) : "") + (f.status ? "&status=" + f.status : "");
          root.innerHTML = '<div class="adm-loading">در حال بارگذاری...</div>';
          A.api(url).then(function (res) {
            if (!fresh()) return;
            var rows = res.subscribers, total = res.total;
            var pages = Math.max(1, Math.ceil(total / perPage));
            // deleting the last row of the last page must not strand the user on an empty page
            if (!rows.length && page > 1) { page = pages; load(); return; }
            var h = A.table([
              { label: "ایمیل", key: "email", ltr: true },
              { label: "وضعیت", html: function (r) { return '<span class="adm-badge ' + esc(r.status) + '">' + esc(A.label("sub", r.status)) + "</span>"; } },
              { label: "منبع", key: "source" },
              { label: "ثبت", key: "created_at", fmt: function (v) { return A.faDate(v); } },
              { label: "تأیید", key: "confirmed_at", fmt: function (v) { return A.faDate(v); } },
              { label: "عملیات", cls: "adm-td-actions", html: function (r) {
                return '<div class="adm-row">'
                  + '<button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-copy="' + esc(r.email) + '">کپی</button>'
                  + (r.status !== "unsubscribed" ? '<button type="button" class="adm-btn adm-btn-ghost adm-btn-sm" data-unsub="' + r.id + '">لغو عضویت</button>' : "")
                  + '<button type="button" class="adm-btn adm-btn-danger adm-btn-sm" data-del="' + r.id + '">حذف</button></div>';
              } },
            ], rows, { empty: "مشترکی پیدا نشد." });
            if (total > perPage) h += A.pager(page, pages, total, "مشترک");
            else h += '<div class="adm-pagination"><span>' + A.faNum(total) + " مشترک</span></div>";
            root.innerHTML = h;
            A.bindPager(root, page, pages, function (p) { page = p; load(); });
            root.querySelectorAll("[data-copy]").forEach(function (b) {
              b.addEventListener("click", function () { A.copyText(b.getAttribute("data-copy")).then(function (ok) { A.toast(ok ? "ایمیل کپی شد." : "کپی نشد.", !ok); }); });
            });
            root.querySelectorAll("[data-unsub]").forEach(function (b) {
              b.addEventListener("click", async function () {
                if (!(await A.confirm("این مشترک لغو عضویت بشه؟", { okText: "لغو عضویت" }))) return;
                try { await A.api("/api/admin/subscribers/" + b.getAttribute("data-unsub") + "/unsubscribe", { method: "POST" }); A.toast("لغو عضویت انجام شد."); load(); }
                catch (e) { A.toast(A.errMsg(e), true); }
              });
            });
            root.querySelectorAll("[data-del]").forEach(function (b) {
              b.addEventListener("click", async function () {
                if (!(await A.confirm("رکورد این مشترک کاملاً حذف بشه؟ این عمل برگشت‌ناپذیره.", { danger: true, okText: "حذف" }))) return;
                try { await A.api("/api/admin/subscribers/" + b.getAttribute("data-del"), { method: "DELETE" }); A.toast("حذف شد."); load(); }
                catch (e) { A.toast(A.errMsg(e), true); }
              });
            });
          }).catch(function (e) { if (fresh()) A.renderError(root, e); });
        }

        document.getElementById("adm-search").addEventListener("click", function () { page = 1; load(); });
        document.getElementById("adm-q").addEventListener("input", A.debounce(function () { page = 1; load(); }, 350));
        document.getElementById("adm-status").addEventListener("change", function () { page = 1; load(); });
        document.getElementById("adm-export").addEventListener("click", async function () {
          var status = document.getElementById("adm-status").value;
          try {
            var res = await A.api("/api/admin/subscribers/export" + (status ? "?status=" + status : ""), { raw: true });
            A.download(await res.blob(), "subscribers.csv");
          } catch (e) { A.toast(A.errMsg(e), true); }
        });
        load();
      });
    });
  </script>
</AdminShell>
